{
  "manifest_version": 2,
  "id": "arcdent.read-history-plugin",
  "version": "0.1.0",
  "name": "跨群历史读取喵",
  "description": "向 LLM 暴露白名单内聊天流的历史读取工具：列出可读聊天流、读中期摘要、读最近若干条原始消息。默认关闭、白名单为空；跨群读取会把目标聊天流的内容带进当前对话。",
  "author": {
    "name": "arcdent",
    "url": "https://github.com/arcdent"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/arcdent/read-history-plugin"
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "capabilities": [
    "chat.get_group_streams",
    "chat.get_private_streams",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "message.get_by_time_in_chat",
    "message.build_readable",
    "database.get",
    "database.count",
    "llm.generate",
    "component.reload_plugin"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
